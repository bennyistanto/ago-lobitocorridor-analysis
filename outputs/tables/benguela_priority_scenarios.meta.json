    {
      "id": "food_security",
      "desc": "Target food-insecure agricultural zones with high growing potential.  Growing season length and EVI productivity identify viable cropland; food-insecurity overlay ensures investment reaches those in greatest need.",
      "preset": "food_security",
      "use_components": [
        1,
        1,
        1,
        0,
        1
      ],
      "weights": {
        "ACC": 0.15,
        "POP": 0.1,
        "VEG": 0.25,
        "NTL": 0.0,
        "DRT": 0.15
