{
  "aoi": "benguela",
  "target_grid": "in-memory",
  "baseline_source": "file",
  "scenarios": [
    {
      "id": "balanced",
      "desc": "General-purpose baseline with no strong thematic emphasis. Additive aggregation with percentile selection for backward compatibility with pre-v2 framework output.",
      "preset": "balanced",
      "use_components": [
        1,
        1,
        0,
        0,
        1
      ],
      "weights": {
        "ACC": 0.35,
        "POP": 0.25,
        "VEG": 0.2,
        "NTL": 0.1,
        "DRT": 0.1
      },
      "overlay_weights": {
        "POV": 0.15,
        "FOOD": 0.1,
        "MTT": 0.1,
        "RWI": 0.15
      },
      "v2_weights": {
        "TT_HEALTH": 0.0,
        "TT_EDUCATION": 0.0,
        "BUILDING_DENSITY": 0.0,
        "DRE_DEMAND": 0.0
      },
      "methodology": {
        "aggregation": "additive",
        "selection_method": "percentile",
        "transforms": {},
        "knockout_rules": {},
        "hotspot_significance": null
      },
      "masks": {
        "require_rural": true,
        "min_cropland": 0.05
      },
      "smooth_radius_cells": 1,
      "selection": {
        "top_pct_cells": 0.1,
        "top_km2": null,
        "min_cluster_cells": 30
      },
      "outputs": {
        "mask_tif": "benguela_priority_mask_balanced.tif"
      }
    },
    {
      "id": "last_mile_access",
      "desc": "Maximise reach to remote, underserved communities far from services.  Geometric aggregation ensures cells must perform across accessibility, poverty, AND facility distance.",
      "preset": "last_mile_access",
      "use_components": [
        1,
        1,
        0,
        0,
        1
      ],
      "weights": {
        "ACC": 0.3,
        "POP": 0.15,
        "VEG": 0.0,
        "NTL": 0.0,
        "DRT": 0.1
      },
      "overlay_weights": {
        "POV": 0.2,
        "FOOD": 0.05,
        "MTT": 0.1,
        "RWI": 0.15
      },
      "v2_weights": {
        "TT_HEALTH": 0.2,
        "TT_EDUCATION": 0.15,
        "BUILDING_DENSITY": 0.0,
        "DRE_DEMAND": 0.1
      },
      "methodology": {
        "aggregation": "geometric",
        "selection_method": "hotspot",
        "transforms": {
          "ACC": {
            "kind": "sigmoid",
            "invert": true,
            "a": 120.0,
            "b": 0.025,
            "c": 0.0,
            "d": 0.0
          },
          "POP": {
            "kind": "log",
            "invert": false,
            "a": 1.0,
            "b": 99.0,
            "c": 0.0,
            "d": 0.0
          },
          "DRT": {
            "kind": "threshold",
            "invert": false,
            "a": 3.0,
            "b": 8.0,
            "c": 0.0,
            "d": 0.0
          },
          "TT_HEALTH": {
            "kind": "sigmoid",
            "invert": true,
            "a": 60.0,
            "b": 0.04,
            "c": 0.0,
            "d": 0.0
          },
          "TT_EDUCATION": {
            "kind": "sigmoid",
            "invert": true,
            "a": 45.0,
            "b": 0.04,
            "c": 0.0,
            "d": 0.0
          },
          "DRE_DEMAND": {
            "kind": "linear",
            "invert": false,
            "a": 0.0,
            "b": 1.0,
            "c": 0.0,
            "d": 0.0
          }
        },
        "knockout_rules": {
          "population": 50
        },
        "hotspot_significance": 0.05
      },
      "masks": {
        "require_rural": true,
        "min_cropland": 0.03
      },
      "smooth_radius_cells": 1,
      "selection": {
        "top_pct_cells": 0.12,
        "top_km2": null,
        "min_cluster_cells": 20
      },
      "outputs": {
        "mask_tif": "benguela_priority_mask_last_mile_access.tif"
      }
    },
    {
